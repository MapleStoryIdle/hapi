{
    "name": "hapi-hub",
    "private": true,
    "version": "0.1.0",
    "description": "Telegram Bot client for SHAPI - control Claude Code sessions",
    "author": "weishu",
    "license": "AGPL-3.0-only",
    "type": "module",
    "exports": {
        "./startHub": {
            "types": "./src/startHub.d.ts",
            "default": "./src/startHub.ts"
        },
        "./managedSkillAdmin": {
            "default": "./src/managedSkillAdmin.ts"
        }
    },
    "scripts": {
        "start": "bun run src/index.ts",
        "dev": "bun --watch run src/index.ts",
        "test": "bun run check:managed-skills && bun test",
        "typecheck": "tsc --noEmit",
        "build": "bun run generate:managed-skills && bun build src/index.ts --outdir dist --target bun",
        "generate:managed-skills": "bun run scripts/generate-managed-skill-library.ts",
        "check:managed-skills": "bun run scripts/generate-managed-skill-library.ts --check",
        "generate:embedded-web-assets": "bun run scripts/generate-embedded-web-assets.ts"
    },
    "dependencies": {
        "@hapi/protocol": "workspace:*",
        "@mozilla/readability": "^0.6.0",
        "@socket.io/bun-engine": "^0.1.0",
        "croner": "10.0.1",
        "grammy": "^1.38.4",
        "hono": "^4.13.5",
        "jose": "^6.1.3",
        "linkedom": "^0.18.13",
        "qrcode": "^1.5.4",
        "socket.io": "^4.8.3",
        "web-push": "^3.6.7",
        "zod": "^4.2.1"
    },
    "devDependencies": {
        "@types/node": ">=25",
        "@types/qrcode": "^1.5.6",
        "@types/web-push": "^3.6.4",
        "bun-types": "^1.3.14",
        "socket.io-client": "^4.8.3",
        "typescript": "^5",
        "vitest": "^4.1.11"
    }
}
